{
  "manifest_version": 3,
  "name": "PrivaSight",
  "version": "1.0.0",
  "description": "A browser agent that redacts faces, text PII and secrets on your device before any model sees the page.",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel",
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open PrivaSight"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.js",
        "content/shield_loader.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}